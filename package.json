{
  "name": "pwomwo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pwomwo, a local-first focus timer with Marinara-style history and serverless multi-device sync",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun run typecheck && bun run scripts/build.ts",
    "preview": "bun run scripts/serve-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-plugin-tailwind": "^0.1.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
